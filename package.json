{
  "name": "xrb-rotating-cube",
  "version": "0.1.0",
  "private": true,
  "description": "A minimal, polished Three.js rotating cube starter for XRealityBytes.",
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "dev": "vite",
    "dev:open": "vite --open",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "vercel:login": "npm exec --yes --package=vercel@65.1.0 -- vercel login",
    "vercel:link": "npm exec --yes --package=vercel@65.1.0 -- vercel link",
    "vercel:git": "npm exec --yes --package=vercel@65.1.0 -- vercel git connect",
    "deploy:preview": "npm run check && npm exec --yes --package=vercel@65.1.0 -- vercel deploy",
    "deploy:production": "npm run check && npm exec --yes --package=vercel@65.1.0 -- vercel deploy --prod"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@types/three": "0.186.0",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5"
  }
}
